@startuml vista_despliegue_implementacion_a
' SAD v1.2 - Vista física de la implementación: despliegue UML del docker-compose real y del teléfono (AD-50 a AD-65, L-01)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #333333
skinparam componentStyle uml2
skinparam BackgroundColor #FFFFFF
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBackgroundColor<<diseño>> #E8E8E8
skinparam ComponentBorderStyle<<diseño>> dashed
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor<<diseño>> #E8E8E8
skinparam QueueBorderColor #333333
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBackgroundColor<<diseño>> #E8E8E8
skinparam NodeBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBackgroundColor<<diseño>> #E8E8E8
skinparam ArtifactBorderColor #333333
skinparam ArtifactBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBackgroundColor<<diseño>> #EFEFEF
skinparam FrameBorderColor #555555
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<diseño>> #E8E8E8
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBorderColor #777777
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontSize 10
skinparam LegendBorderColor #777777
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendFontSize 10
skinparam StereotypeFontSize 10
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor<<diseño>> #E8E8E8
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 18
skinparam ArrowFontSize 15
skinparam StereotypeFontSize 14
skinparam LegendFontSize 15
skinparam NoteFontSize 15
skinparam PackageFontSize 17
skinparam nodesep 12
skinparam ranksep 30

node "Teléfono Android 8+  [*]" <<device>> as TEL {
  node "Android Runtime" <<executionEnvironment>> as ART {
    artifact "DanosCampo.apk\nco.plataforma.danos 2.1.0" <<artifact>> as APK
    artifact "danos.db\nRoom, esquema 3" <<artifact>> as DDB
  }
}


node "Computador (Windows 11)" <<device>> as PC {
  node "Navegador web" <<executionEnvironment>> as NAV {
    artifact "consola Angular\n(servida por web)" <<artifact>> as NAV_a
  }
  node "Docker Engine 29 / Docker Compose  (proyecto plataforma)" <<executionEnvironment>> as DK {
  package "Entrada e identidad" as PE {
    node GW <<executionEnvironment>> [
    **gateway**  [2]
    ----
    «artifact» plataforma/gateway:local
    ]

    node WEB <<executionEnvironment>> [
    **web**  [1]
    ----
    «artifact» plataforma-web
    (consola en nginx 1.29)
    ]

    node KC <<executionEnvironment>> [
    **keycloak**  [1]
    ----
    «artifact» quay.io/keycloak/keycloak:26.5.2
    ]

  }
  package "Microservicios" as PM {
    node GD <<executionEnvironment>> [
    **gestion-desastres**  [2]
    ----
    «artifact» plataforma/gestion-desastres:local
    ]

    node ED <<executionEnvironment>> [
    **evaluacion-danos**  [2]
    ----
    «artifact» plataforma/evaluacion-danos:local
    ]

    node RC <<executionEnvironment>> [
    **reconstruccion**  [2]
    ----
    «artifact» plataforma/reconstruccion:local
    ]

    node CP <<executionEnvironment>> [
    **consulta-programa**  [2]
    ----
    «artifact» plataforma/reconstruccion:local
    (Reconstruccion__Rol=consulta)
    ]

    node CQ <<executionEnvironment>> [
    **consulta**  [2]
    ----
    «artifact» plataforma/consulta:local
    ]

    node CD <<executionEnvironment>> [
    **consulta-danos**  [2]
    ----
    «artifact» plataforma/consulta-danos:local
    ]

    node AU <<executionEnvironment>> [
    **auditoria**  [2]
    ----
    «artifact» plataforma/auditoria:local
    ]

  }
  package "Datos y mensajería" as PD {
    node DB <<executionEnvironment>> [
    **db**
    ----
    «artifact» postgis/postgis:18-3.6
    (10 bases, una por servicio;
    adaptador_se8 para SE-8)
    ]

    node DBR <<executionEnvironment>> [
    **db-replica**
    ----
    «artifact» postgis/postgis:18-3.6
    ]

    node B1 <<executionEnvironment>> [
    **bus1**
    ----
    «artifact» rabbitmq:4.4.0-management
    ]

    node B2 <<executionEnvironment>> [
    **bus2**
    ----
    «artifact» rabbitmq:4.4.0-management
    ]

    node B3 <<executionEnvironment>> [
    **bus3**
    ----
    «artifact» rabbitmq:4.4.0-management
    ]

    node CA <<executionEnvironment>> [
    **cache**
    ----
    «artifact» redis:8.8.4-alpine
    ]

    node AR <<executionEnvironment>> [
    **archivos**
    ----
    «artifact» pgsty/minio (MinIO, API S3)
    ]

  }
  }
}


APK -- GW : <<HTTP JSON>> :8080\n(HTTPS en producción)
APK -- KC : <<OIDC con PKCE>> :8180
NAV_a -- GW : <<HTTP JSON>> :8080
GW -- WEB : <<HTTP>>
GW -- KC : <<HTTP>> JWKS
GW -- PM : <<HTTP JSON>> :8080\nrutas.json
PM -- PD : <<AMQP>> :5672 a bus1..3\n«SQL» :5432 a db
ED -- AR : <<S3>> :9000
RC -- AR : <<S3>> :9000
CQ -- CA : <<RESP>> :6379
CD -- CA : <<RESP>> :6379
DB -right- DBR : <<replicación\nde streaming>>
B1 -right- B2 : <<clúster>>
B2 -right- B3 : <<clúster>>

KC -[hidden]down- GD
WEB -[hidden]down- GD
CP -[hidden]down- B1
CP -[hidden]down- DB
GD -[hidden]down- AU
ED -[hidden]down- CQ
RC -[hidden]down- CD
AU -[hidden]down- CP
B1 -[hidden]down- DB
B3 -[hidden]down- AR



legend bottom left
  **Figura 4a de 2.** Los adaptadores, los simuladores y los migradores están en la Figura 4b.
  **Notación** (diagrama de despliegue UML). «device»: equipo físico. «executionEnvironment»: entorno de ejecución; dentro de
  Docker, un contenedor por servicio de docker-compose.yml con su nombre exacto.
  «artifact»: imagen o archivo desplegado; en cada contenedor se lista la imagen en el compartimento del nodo. [n]: réplicas
  (deploy.replicas). Línea: ruta de comunicación con protocolo y puerto. Puertos publicados en el computador: 8080 y 8081 (gateway),
  8180 (keycloak), 15672 (bus1), 9001 (archivos).
  **Kubernetes** (despliegue/k8s, AD-65): los mismos artefactos se despliegan como Deployments; HPA escala consulta y consulta-danos
  (2 a 6) y consulta-programa (2 a 5) por CPU; KEDA escala adaptador-se6 y adaptador-se7-salida de 0 a 4 por el largo de
  q.salida.se6 y q.salida.se7, y enciende adaptador-se7-entrada con un disparador cron. KEDA mantiene adaptador-se8 entre 1 y 2
  réplicas (mínimo 1 por QA-08, AD-25).
endlegend
@enduml
