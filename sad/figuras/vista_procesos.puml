@startuml vista_procesos
' SAD v1.3 - Vista de procesos: procesos, hilos, réplicas, exchanges y colas reales (AD-02, AD-18, AD-24, AD-25, AD-45, AD-46, AD-47, AD-54)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #333333
skinparam componentStyle uml2
skinparam BackgroundColor #FFFFFF
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBackgroundColor<<diseño>> #E8E8E8
skinparam ComponentBorderStyle<<diseño>> dashed
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor<<diseño>> #E8E8E8
skinparam QueueBorderColor #333333
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBackgroundColor<<diseño>> #E8E8E8
skinparam NodeBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBackgroundColor<<diseño>> #E8E8E8
skinparam ArtifactBorderColor #333333
skinparam ArtifactBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBackgroundColor<<diseño>> #EFEFEF
skinparam FrameBorderColor #555555
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<diseño>> #E8E8E8
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBorderColor #777777
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontSize 10
skinparam LegendBorderColor #777777
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendFontSize 10
skinparam StereotypeFontSize 10
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor<<diseño>> #E8E8E8
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 18
skinparam ArrowFontSize 15
skinparam StereotypeFontSize 14
skinparam LegendFontSize 15
skinparam NoteFontSize 15
skinparam PackageFontSize 17
left to right direction
skinparam nodesep 5
skinparam ranksep 40

package "Clientes" {
  component "Consola de coordinación\nnavegador, servida por web" <<process>> <<implementado>> as CC
  component "Cliente móvil [1 por teléfono]\nhilo SincronizacionWorker (WorkManager)" <<process>> <<implementado>> as CM
  component "Portal público" <<process>> <<diseño>> as PP
}

component "gateway  [2]\nYARP, valida JWT, prioriza" <<process>> <<implementado>> as GW

package "Procesos productores" as PROD <<implementado>> {
  component "gestion-desastres  [2]\nhilo HTTP | hilo relevo de bandeja\nhilo consumidor" <<process>> as GD
  component "evaluacion-danos  [2]\nhilo HTTP | hilo relevo de bandeja\nhilo consumidor" <<process>> as ED
  component "reconstruccion  [2]\nhilo HTTP | hilo relevo de bandeja\nhilo consumidor" <<process>> as RC
  component "adaptador-se2  [1]\ncarga de la capa de municipios | hilo relevo" <<process>> as A2
  component "adaptador-se7-entrada  [1]\nsondeo de SE-7 cada 30 s | hilo relevo" <<process>> as A7E
  component "adaptador-se6  [2]\nconsumidor | hilo relevo" <<process>> as A6
  component "adaptador-se7-salida  [2]\nconsumidor | hilo relevo" <<process>> as A7S
  component "adaptador-se8  [1] siempre encendido (AD-25, QA-08)\nWildFly: consumidor JMS | relevo @Schedule\n| reenvío sin acuse | HTTP acuse" <<process>> as A8
}

package "Procesos de diseño" as DIS <<diseño>> {
  component "Consolidación  [2..*]" <<process>> as CO #E8E8E8;line.dashed
  component "Notificación  [2..*]" <<process>> as NO #E8E8E8;line.dashed
  component "Gestión de Recursos  [2..*]" <<process>> as GR #E8E8E8;line.dashed
  component "Personas Afectadas, Coordinación\nde Organismos  [2..*]" <<process>> as PA #E8E8E8;line.dashed
  component "Adaptadores SE-1, SE-3,\nSE-4, SE-5  [0..*]" <<process>> as AX #E8E8E8;line.dashed
}

package "Bus de eventos [bus1, bus2, bus3]  colas quorum acotadas (AD-54)" as BUS {
  queue "plataforma.eventos\n(topic, clave evNN.agregado.hecho)" as EX
  queue "q.gestion-desastres\nev18, ev20, ev21" as qGD
  queue "q.evaluacion-danos\nev03, ev05, ev06, ev21, ev27" as qED
  queue "q.reconstruccion\nev03, ev06, ev08, ev21, ev24" as qRC
  queue "q.consulta-programa\nev18, ev19, ev20, ev23" as qCP
  queue "q.consulta\nev03 a ev06, ev21, ev23, ev27" as qCQ
  queue "q.consulta-danos\nev08 a ev10, ev21 a ev23, ev25, ev26" as qCD
  queue "q.auditoria\n~# (todos los eventos)" as qAU
  queue "q.salida.se6\nev18, ev19, ev20" as qS6
  queue "q.salida.se7\nev18, ev20" as qS7
  queue "q.notificacion\nev03, ev04, ev29" as qNO
  queue "q.salida.se8\nev28; ev03, ev04 (sustituto, L-11)" as qS8
  queue "plataforma.sin-ruta (fanout)\n→ q.sin-ruta" as SR
  queue "plataforma.dlx (direct)\n→ dlq.<cola>, una por cada q.*" as DLX
}

package "Procesos consumidores" as CONS <<implementado>> {
  component "consulta-programa  [2]\nimagen plataforma/reconstruccion\nReconstruccion__Rol=consulta" <<process>> as CP
  component "consulta  [2]\nhilo HTTP | consumidor" <<process>> as CQ
  component "consulta-danos  [2]\nhilo HTTP | consumidor" <<process>> as CD
  component "auditoria  [2]\nhilo HTTP | consumidor" <<process>> as AU
}

CC --> GW : HTTP/JSON
CM --> GW : HTTP/JSON
PP --> GW : HTTP/JSON
GW --> GD : HTTP
GW --> ED : HTTP
GW --> RC : HTTP
GW -[norank]-> CONS : HTTP

GD ..> EX : EV-03 a EV-06, EV-27
ED ..> EX : EV-08 a EV-10,\nEV-22, EV-25, EV-26
RC ..> EX : EV-18 a EV-20
A2 ..> EX : EV-21
A7E ..> EX : EV-24, EV-23
A6 ..> EX : EV-23
A7S ..> EX : EV-23
CO ..> EX : EV-02
NO ..> EX : EV-07, EV-28
GR ..> EX : EV-12, EV-13,\nEV-16, EV-17
A8 ..> EX : EV-23, EV-29
AX ..> EX : EV-01, EV-11,\nEV-14, EV-15
PA ..> EX

EX ..> qGD
EX ..> qED
EX ..> qRC
EX ..> qCP
EX ..> qCQ
EX ..> qCD
EX ..> qAU
EX ..> qS6
EX ..> qS7
EX ..> qNO
EX ..> qS8
EX ..> SR : sin enlace
qAU ..> DLX : rechazo o\nexpiración (cada q.*)

qGD .[norank].> GD
qED .[norank].> ED
qRC .[norank].> RC
qS6 .[norank].> A6
qS7 .[norank].> A7S
qNO .[norank].> NO
qS8 .[norank].> A8
qCP ..> CP
qCQ ..> CQ
qCD ..> CD
qAU ..> AU

note bottom of PROD
  **Relevo de bandeja de salida** (AD-45, RelevoBandeja de
  Plataforma.Comun.Mensajeria): el hecho y su fila de bandeja
  se escriben en una transacción; un hilo de fondo los publica
  con confirmación del bus. Lo usa todo productor.
end note
note bottom of CONS
  **Consumo idempotente** (ConsumidorIdempotente): cada
  consumidor registra la claveIdempotencia y descarta
  reenvíos. Las réplicas [2] compiten por su cola.
end note

legend bottom left
  **Notación**. Componente «process»: proceso en ejecución, con sus hilos separados por |. [n]: réplicas en docker-compose. Paquete «implementado»: todos sus procesos están en docker-compose. «diseño» (fondo gris, borde discontinuo): sin implementar.
  Flecha continua: llamada síncrona HTTP/JSON. Flecha discontinua: mensaje AMQP. Cola: rótulo con las claves de enlace (evNN.#) tomadas de definiciones.json.
  El adaptador de SE-7 corre en dos procesos de la misma imagen: adaptador-se7-salida y adaptador-se7-entrada. consulta-programa es el segundo proceso de la imagen de Reconstrucción.
  adaptador-se8 es el único proceso Java (Jakarta EE 11 en WildFly 42, AD-66). SE-8 le envía el acuse por HTTP, por una ruta solo de la red interna.
endlegend
@enduml
