skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 18
skinparam ArrowFontSize 15
skinparam StereotypeFontSize 14
skinparam LegendFontSize 15
skinparam NoteFontSize 15
skinparam PackageFontSize 17
skinparam nodesep 12
skinparam ranksep 30

node "Teléfono Android 8+  [*]" <<device>> as TEL {
  node "Android Runtime" <<executionEnvironment>> as ART {
    artifact "DanosCampo.apk\nco.plataforma.danos 2.1.0" <<artifact>> as APK
    artifact "danos.db\nRoom, esquema 3" <<artifact>> as DDB
  }
}

node "Computador (Windows 11)" <<device>> as PC {
  node "Navegador web" <<executionEnvironment>> as NAV {
    artifact "consola Angular\n(servida por web)" <<artifact>> as NAV_a
  }
  node "Docker Engine 29 / Docker Compose  (proyecto plataforma)" <<executionEnvironment>> as DK {
  package "Entrada e identidad" as PE {
    node GW <<executionEnvironment>> [
    **gateway**  [2]
    ----
    «artifact» plataforma/gateway:local
    ]

    node WEB <<executionEnvironment>> [
    **web**  [1]
    ----
    «artifact» plataforma-web
    (consola en nginx 1.29)
    ]

    node KC <<executionEnvironment>> [
    **keycloak**  [1]
    ----
    «artifact» quay.io/keycloak/keycloak:26.5.2
    ]

  }
  package "Microservicios" as PM {
    node GD <<executionEnvironment>> [
    **gestion-desastres**  [2]
    ----
    «artifact» plataforma/gestion-desastres:local
    ]

    node ED <<executionEnvironment>> [
    **evaluacion-danos**  [2]
    ----
    «artifact» plataforma/evaluacion-danos:local
    ]

    node RC <<executionEnvironment>> [
    **reconstruccion**  [2]
    ----
    «artifact» plataforma/reconstruccion:local
    ]

    node CP <<executionEnvironment>> [
    **consulta-programa**  [2]
    ----
    «artifact» plataforma/reconstruccion:local
    (Reconstruccion__Rol=consulta)
    ]

    node CQ <<executionEnvironment>> [
    **consulta**  [2]
    ----
    «artifact» plataforma/consulta:local
    ]

    node CD <<executionEnvironment>> [
    **consulta-danos**  [2]
    ----
    «artifact» plataforma/consulta-danos:local
    ]

    node AU <<executionEnvironment>> [
    **auditoria**  [2]
    ----
    «artifact» plataforma/auditoria:local
    ]

  }
  package "Adaptadores y simuladores" as PA {
    node A2 <<executionEnvironment>> [
    **adaptador-se2**  [1]
    ----
    «artifact» plataforma/adaptador-se2:local
    ]

    node A6 <<executionEnvironment>> [
    **adaptador-se6**  [2]
    ----
    «artifact» plataforma/adaptador-se6:local
    ]

    node A7S <<executionEnvironment>> [
    **adaptador-se7-salida**  [2]
    ----
    «artifact» plataforma/adaptador-se7:local
    ]

    node A7E <<executionEnvironment>> [
    **adaptador-se7-entrada**  [1]
    ----
    «artifact» plataforma/adaptador-se7:local
    ]

    node S6 <<executionEnvironment>> [
    **sim-se6**  [1]
    ----
    «artifact» plataforma/sim-se6:local
    ]

    node S7 <<executionEnvironment>> [
    **sim-se7**  [1]
    ----
    «artifact» plataforma/sim-se7:local
    ]

    node A8 <<executionEnvironment>> [
    **adaptador-se8**  [1, siempre encendido]
    ----
    «executionEnvironment» WildFly 42.0.0.Final
    Jakarta EE 11 sobre Java 21 (AD-66)
    ----
    «artifact» adaptador-se8.war
    imagen plataforma/adaptador-se8:local
    ]

    node S8 <<executionEnvironment>> [
    **sim-se8**  [1]
    ----
    «artifact» plataforma/sim-se8:local
    ]

  }
  package "Datos y mensajería" as PD {
    node DB <<executionEnvironment>> [
    **db**
    ----
    «artifact» postgis/postgis:18-3.6
    (10 bases, una por servicio;
    adaptador_se8 para SE-8)
    ]

    node DBR <<executionEnvironment>> [
    **db-replica**
    ----
    «artifact» postgis/postgis:18-3.6
    ]

    node B1 <<executionEnvironment>> [
    **bus1**
    ----
    «artifact» rabbitmq:4.4.0-management
    ]

    node B2 <<executionEnvironment>> [
    **bus2**
    ----
    «artifact» rabbitmq:4.4.0-management
    ]

    node B3 <<executionEnvironment>> [
    **bus3**
    ----
    «artifact» rabbitmq:4.4.0-management
    ]

    node CA <<executionEnvironment>> [
    **cache**
    ----
    «artifact» redis:8.8.4-alpine
    ]

    node AR <<executionEnvironment>> [
    **archivos**
    ----
    «artifact» pgsty/minio (MinIO, API S3)
    ]

  }
  package "Migradores: misma imagen del servicio con el argumento migrar (corren una vez)" as PMG {
    node MG1 <<executionEnvironment>> [
    **gestion-desastres-migrador**
    ----
    «artifact» plataforma/gestion-desastres:local
    ]

    node MG2 <<executionEnvironment>> [
    **evaluacion-danos-migrador**
    ----
    «artifact» plataforma/evaluacion-danos:local
    ]

    node MG3 <<executionEnvironment>> [
    **reconstruccion-migrador**
    ----
    «artifact» plataforma/reconstruccion:local
    ]

    node MG4 <<executionEnvironment>> [
    **consulta-migrador**
    ----
    «artifact» plataforma/consulta:local
    ]

    node MG5 <<executionEnvironment>> [
    **consulta-danos-migrador**
    ----
    «artifact» plataforma/consulta-danos:local
    ]

    node MG6 <<executionEnvironment>> [
    **auditoria-migrador**
    ----
    «artifact» plataforma/auditoria:local
    ]

    node MG7 <<executionEnvironment>> [
    **adaptador-se2-migrador**
    ----
    «artifact» plataforma/adaptador-se2:local
    ]

    node MG8 <<executionEnvironment>> [
    **adaptador-se6-migrador**
    ----
    «artifact» plataforma/adaptador-se6:local
    ]

    node MG9 <<executionEnvironment>> [
    **adaptador-se7-migrador**
    ----
    «artifact» plataforma/adaptador-se7:local
    ]

    node MG10 <<executionEnvironment>> [
    **adaptador-se8-migrador**
    ----
    «artifact» plataforma/adaptador-se8-migrador:local
    (Java 21, Flyway)
    ]

  }
  }
}

