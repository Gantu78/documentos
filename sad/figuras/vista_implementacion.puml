package "servicios/evaluacion-danos (microservicio tipo)" as SED {
  package "EvaluacionDanos.Api" as EApi {
    package "Controllers" as ECtl {
      class "SincronizacionController" as SC
      class "DescargaController" as DC
      class "EvidenciasController" as EVC
      class "ConflictosController" as CFC
    }
    package "Seguridad" as ESeg {
      class "RequiereRolAttribute\n(nivel 2, AD-22)" as AUT
    }
  }
  package "EvaluacionDanos.Aplicacion" as EApl {
    package "CasosDeUso" as ECU {
      class "SincronizarLote" as SL
      class "SubirEvidencia" as SE
      class "Revision" as RV
    }
    package "Puertos" as EPu {
      interface "IAlmacenEvaluaciones" as IAE
      interface "IAlmacenEvidencias" as IAV
      interface "IPublicadorHechos" as IPH
    }
  }
  package "EvaluacionDanos.Dominio" as EDom {
    class "ReglaConflicto\n(AD-43)" as RCF
    class "DetectorDuplicados" as DD
    class "ValidadorEvaluacion" as VE
    class "Entidades" as ENT
  }
  package "EvaluacionDanos.Infraestructura" as EInf {
    package "Persistencia" as EPer {
      class "EvaluacionDanosDbContext" as CTX
      class "AlmacenEvaluacionesEf" as AEF
    }
    package "Mensajeria" as EMsj {
      class "PublicadorHechosBandeja\n(AD-45)" as PHB
      class "ManejadorEventosEntrantes" as MEE
    }
    package "Archivos" as EArc {
      class "AlmacenEvidenciasMinio" as AEM
    }
  }
}

package "comun" as COM {
  package "Plataforma.Comun.Eventos" as CEv {
    class "CatalogoEventos\n(EV-01 a EV-29)" as CAT
    class "Sobre" as SOB
  }
  package "Plataforma.Comun.Mensajeria" as CMs {
    class "EscritorBandeja" as EB
    class "RelevoBandeja" as RB
    class "ConsumidorIdempotente" as CI
  }
  package "Plataforma.Comun.Adaptadores" as CAd {
    interface "IContratoAdaptador" as ICA
    class "Resiliencia (AD-64)" as RES
    class "MarcaAvance" as MA
  }
  package "Plataforma.Comun.Seguridad" as CSe {
    class "ValidadorJwt" as VJ
    class "IdentidadPorJwt" as IJ
  }
  package "Plataforma.Comun.Salud" as CSa {
    class "SaludPlataforma" as SP
  }
  package "Plataforma.Comun.Migraciones" as CMi {
    class "Migrador" as MIG
  }
}

package "Otros microservicios (misma estructura Api, Aplicacion, Dominio, Infraestructura)" as OTR {
  package "servicios/gestion-desastres\nGestionDesastres.*" as PGD {
}
  package "servicios/reconstruccion\nReconstruccion.*\n(roles escritura y consulta)" as PRC {
}
  package "servicios/consulta\nConsulta.*" as PCQ {
}
  package "servicios/consulta-danos\nConsultaDanos.*" as PCD {
}
  package "servicios/auditoria\nAuditoria.*" as PAU {
}
}

package "adaptadores" as ADP {
  package "adaptador-se2\nAdaptadorSe2" as PA2 {
}
  package "adaptador-se6\nAdaptadorSe6" as PA6 {
}
  package "adaptador-se7\nAdaptadorSe7\n(modos salida y entrada)" as PA7 {
}
}

package "gateway\nPlataforma.Gateway\n(rutas.json, AutorizacionNivel1)" as PGW {
}
package "consola (Angular)\nmodulos: mapa, evaluaciones,\nreconstruccion, acceso; nucleo" as PCO {
}

EApi ..> EApl
EApi ..> EInf : <<use>>\n(composición)
EApl ..> EDom
EInf ..> EApl
AEF ..|> IAE
AEM ..|> IAV
PHB ..|> IPH
SL ..> RCF
SL ..> DD
SL ..> VE

EApi ..> CSe
EApi ..> CSa
EInf ..> CEv
EInf ..> CMs
EInf ..> CMi
PHB ..> EB
CMs ..> CEv
CAd ..> CMs

OTR ..> COM
ADP ..> CEv
ADP ..> CMs
ADP ..> CMi
PA6 ..> CAd
PA7 ..> CAd
PGW ..> CSe
PGW ..> CSa
PCO ..> PGW : HTTP JSON
PGD -[hidden]-> PRC
PCQ -[hidden]-> PCD
PA2 -[hidden]-> PA6

legend bottom left
  **Notación** (diagrama de paquetes UML). Paquete: carpeta del monorepo o proyecto .NET (*.csproj). Rectángulo: clase o archivo clave real. Interfaz: puerto que implementa la infraestructura (realización con línea discontinua y triángulo).
  Flecha discontinua: dependencia «use» (referencia de proyecto ProjectReference o uso de código). Regla de capas (AD-08): Dominio no depende de nadie; Aplicacion depende de Dominio; Infraestructura implementa los Puertos de Aplicacion; Api compone todo.
  Ningún microservicio referencia a otro ni a un adaptador; todos dependen solo de comun. El esquema de los eventos está en Plataforma.Comun.Eventos (Esquemas) y no es un componente ejecutable.
endlegend
@enduml
