@startuml casos_uso
' SAD v1.2 - Vista de escenarios: diagrama de casos de uso UML (FP-01 a FP-10; RF-GD-02, AD-48, E-42)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #333333
skinparam componentStyle uml2
skinparam BackgroundColor #FFFFFF
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBackgroundColor<<diseño>> #E8E8E8
skinparam ComponentBorderStyle<<diseño>> dashed
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor<<diseño>> #E8E8E8
skinparam QueueBorderColor #333333
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBackgroundColor<<diseño>> #E8E8E8
skinparam NodeBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBackgroundColor<<diseño>> #E8E8E8
skinparam ArtifactBorderColor #333333
skinparam ArtifactBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBackgroundColor<<diseño>> #EFEFEF
skinparam FrameBorderColor #555555
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<diseño>> #E8E8E8
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBorderColor #777777
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontSize 10
skinparam LegendBorderColor #777777
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendFontSize 10
skinparam StereotypeFontSize 10
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor<<diseño>> #E8E8E8
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 14
skinparam StereotypeFontSize 12
skinparam LegendFontSize 12
left to right direction
skinparam nodesep 6
skinparam ranksep 40

actor "SE-1 Alertas y\nmonitoreo" <<sistema externo>> as SE1
actor "Ciudadano" as CIU
actor "Organismo de\nrespuesta" as ORG
actor "Organismo de\nrespuesta en campo" as ORC
actor "Autoridad" as AUT
actor "Evaluador\nde campo" as EVA
actor "Operador de\nla plataforma" as OPE

actor "SE-2 GIS" <<sistema externo>> as SE2
actor "SE-4 Gestión\nde recursos" <<sistema externo>> as SE4
actor "SE-5 Personas\nafectadas" <<sistema externo>> as SE5
actor "SE-6 y SE-7 Finanzas\ny proyectos" <<sistema externo>> as SE67
actor "SE-8\nNotificación" <<sistema externo>> as SE8

ORC --|> ORG

rectangle "Plataforma para la Gestión de Desastres y Reconstrucción" {
  usecase "FP-01 Registrar un desastre\ndesde un sistema externo" as FP01
  usecase "Registrar y caracterizar un\ndesastre en campo\n(RF-GD-02, AD-48)" as FPC
  usecase "FP-02 Consultar y monitorear\nel estado de un desastre" as FP02
  usecase "FP-03 Actualizar la severidad\ny la delimitación" as FP03
  usecase "FP-04 Consolidar reportes\nde distintas fuentes" as FP04
  usecase "FP-05 Notificar a\nlos organismos" as FP05
  usecase "FP-06 Registrar una evaluación de\ndaños en campo y sincronizarla" as FP06
  usecase "FP-07 Solicitar y asignar\nun recurso" as FP07
  usecase "FP-08 Crear proyectos de reconstrucción\na partir de evaluaciones" as FP08
  usecase "FP-09 Asignar responsabilidades\ny dar seguimiento a las tareas" as FP09
  usecase "FP-10 Registrar personas afectadas\ncon protección de sus datos" as FP10
}

SE1 --> FP01
ORC --> FPC
CIU --> FP02
ORG --> FP02
ORG --> FP09
ORG --> FP07
ORG --> FP10
AUT --> FP02
AUT --> FP03
AUT --> FP07
AUT --> FP08
AUT --> FP09
EVA --> FP06
OPE --> FP04

FP01 ..> FP04 : <<include>>
FP01 ..> FP05 : <<include>>
FPC ..> FP05 : <<include>>
FP03 ..> FP05 : <<include>>

FP03 --> SE2
FP07 --> SE4
FP10 --> SE5
FP08 --> SE67
FP05 --> SE8

legend bottom left
  **Notación** (diagrama de casos de uso UML). Actor: rol humano o sistema externo («sistema externo»). Elipse: caso de uso. Línea con flecha: asociación iniciada por el actor o dirigida al sistema externo.
  «include»: el caso base siempre ejecuta el caso incluido. Triángulo hueco: generalización de actores; el organismo de respuesta en campo es un organismo de respuesta que registra el desastre desde el cliente móvil, sin conexión, con identificador generado en el teléfono (E-42).
endlegend
@enduml
