hide empty members
hide circle
set separator none
left to right direction

package "com.example.danos  (DanosCampo.apk, co.plataforma.danos 2.1.0)" as APP {
  package "presentacion  (Jetpack Compose, ViewModel)" as PRE {
    package "ingreso" as P1 {
      class "IngresoViewModel" as IVM
    }
    package "lista" as P2 {
      class "ListaViewModel" as LVM
    }
    package "evaluar" as P3 {
      class "EvaluarViewModel" as EVM
    }
    package "descarga" as P4 {
      class "DescargaViewModel" as DVM
    }
    package "desastre" as P5 {
      class "RegistrarDesastreViewModel" as RVM
      class "DesastresPantalla" as DP
    }
    package "navegacion" as P6 {
      class "AppNavegacion" as NAV
    }
    package "componentes, tema" as P7 {
      class "EvaluacionCard, ChipEstado,\nIndicadorConexion" as COMP
    }
  }
  package "acceso  (repositorios)" as ACC {
    interface "EvaluacionRepositorio" as ER
    interface "DesastreRepositorio" as DR
    interface "SincronizacionRepositorio" as SR
    interface "IdentidadRepositorio" as IR
    interface "CatalogoRepositorio,\nConfiguracionRepositorio,\nDispositivoRepositorio" as OR
  }
  package "dominio" as DOM {
    class "Modelos" as MOD
    class "RegistroDesastre" as RD
    class "ValidadorEvaluacion" as VE
    class "ValidadorRegistroDesastre" as VRD
    class "ValidadorIngreso, Limites, Fotos" as VOT
  }
  package "infraestructura" as INF {
    package "local  (Room)" as LOC {
      class "AppDatabase\nversion 3, tabla registro_desastre" as ADB
      class "Daos, Entidades,\nRegistroDesastreLocal" as DAO
    }
    package "sync  (WorkManager)" as SYN {
      class "SincronizacionWorker" as SW
      class "MotorSincronizacion" as MS
      class "EnviadorDesastres" as ENV
      class "ProgramadorSincronizacion" as PS
    }
    package "remoto  (Retrofit, OkHttp)" as REM {
      interface "DanosApi" as DA
      interface "DesastresApi" as DSA
      class "ConfiguracionInterceptor" as CI
      class "ProbadorConexion" as PC
    }
    package "identidad  (AppAuth)" as IDE {
      class "IdentidadRepositorioImpl" as IRI
      class "ConexionOidcBuilder" as COB
      class "CifradorDatos\n(Android Keystore)" as CD
    }
    package "dispositivo" as DIS {
      class "Conectividad, ServicioUbicacion,\nProcesadorFotos" as DSP
    }
    package "preferencias" as PRF {
      class "PreferenciasLocales" as PL
    }
    package "di  (Hilt)" as DI {
      class "ModuloDatos, ModuloRed,\nModuloDispositivo, ModuloEnlaces" as MODS
    }
  }
}

PRE ..> ACC : <<use>>
PRE ..> DOM : <<use>>
ACC ..> DOM : <<use>>
ACC ..> INF : <<use>>\n(implementaciones *Impl)
INF ..> DOM : <<use>>
RVM ..> DR
DR ..> VRD
SW ..> MS
MS ..> ENV
ENV ..> DSA
ENV ..> DAO
MS ..> DA
IRI ..|> IR
IRI ..> COB
IRI ..> CD
DI ..> LOC
DI ..> REM

legend bottom left
  **Notación** (diagrama de paquetes UML). Paquete: paquete Kotlin real bajo app/src/main/java/com/example/danos. Rectángulo: clase o archivo clave. Interfaz: contrato que otra capa implementa (realización con triángulo).
  Flecha discontinua: dependencia «use» (import). Capas: presentacion → acceso → dominio; infraestructura implementa los repositorios de acceso y depende de dominio. presentacion no importa infraestructura.
  La base local danos.db (Room, esquema 3) guarda la réplica, la cola de operaciones (AD-44) y registro_desastre con estado PENDIENTE, ENVIADO o RECHAZADO (AD-48).
endlegend
@enduml
