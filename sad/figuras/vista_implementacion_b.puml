package "adaptadores" as ADP {
  package "adaptador-se2\nAdaptadorSe2" as PA2 {
}
  package "adaptador-se6\nAdaptadorSe6" as PA6 {
}
  package "adaptador-se7\nAdaptadorSe7\n(modos salida y entrada)" as PA7 {
}
  package "adaptador-se8-jee  (Maven, Java 21, WAR para WildFly 42; AD-66)" as PA8 {
    package "plataforma.adaptador.se8.contrato" as J8C {
      interface "ContratoAdaptador<E>\n(equivale a IContratoAdaptador)" as J8I
      class "Sobre" as J8S
      class "ValidadorContrato" as J8V
    }
    package "plataforma.adaptador.se8.jee  (EJB y CDI)" as J8E {
      class "AdaptadorSe8\n@Stateless" as J8A
      class "ManejadorSe8\n@Stateless, REQUIRES_NEW" as J8M
      class "ConsumidorSe8\n@Singleton @Startup" as J8K
      class "Temporizadores\n@Schedule" as J8T
    }
    package "consumo  (Jakarta Messaging)" as J8Q {
      class "BucleConsumo" as J8B
      class "PublicadorJms" as J8P
    }
    package "traduccion, resiliencia, cliente\n(TraduccionSe8, Cortacircuitos,\nEjecutorResiliente, TransporteJaxRs)" as J8R {
    }
    package "persistencia  (Jakarta Persistence)\nEntrega, FilaBandeja, AlmacenJpa" as J8D {
    }
    package "api  (Jakarta REST)\nRecursoAcuses, RecursoSalud,\nRecursoEntregas" as J8W {
    }
    package "migrador\nMigrador (Flyway)" as J8G {
    }
  }
}

package "comun (detalle en la Figura 5, parte 1)" as COM {
  package "Plataforma.Comun.Eventos\n(sobre canónico y esquemas JSON EV-nn.v1.json)" as CEv {
  }
  package "Plataforma.Comun.Mensajeria\n(bandeja, relevo, consumidor idempotente)" as CMs {
  }
  package "Plataforma.Comun.Adaptadores\n(IContratoAdaptador, Resiliencia, MarcaAvance)" as CAd {
  }
  package "Plataforma.Comun.Migraciones" as CMi {
  }
}

CMs ..> CEv
CAd ..> CMs
ADP ..> CEv
ADP ..> CMs
ADP ..> CMi
PA6 ..> CAd
PA7 ..> CAd
J8A ..|> J8I
J8K ..> J8B
J8B ..> J8M
J8M ..> J8A
J8M ..> J8D
J8T ..> J8P
J8A ..> J8R
J8W ..> J8M
J8V ..> CEv : <<use>> esquemas JSON\ncopiados al compilar
PA2 -[hidden]-> PA6
legend bottom left
  **Figura 5, parte 2 de 2.** Adaptadores. Los tres de .NET implementan IContratoAdaptador de Plataforma.Comun.Adaptadores.
  adaptador-se8-jee es Java (Jakarta EE 11, AD-66): no referencia proyectos .NET y comparte el contrato por los esquemas JSON de Plataforma.Comun.Eventos.
  Paquete: carpeta o proyecto. Rectángulo: clase. Interfaz: realización con línea discontinua y triángulo. Flecha discontinua: dependencia «use».
endlegend
