@startuml seq_registro_desastre
' SAD v1.2 - Registro y caracterización de un desastre en campo desde el cliente móvil (RF-GD-02, RF-GD-03, RF-GD-05, RF-GD-08; QA-07; AD-44, AD-45, AD-48, AD-49; E-42)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #333333
skinparam componentStyle uml2
skinparam BackgroundColor #FFFFFF
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBackgroundColor<<diseño>> #E8E8E8
skinparam ComponentBorderStyle<<diseño>> dashed
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor<<diseño>> #E8E8E8
skinparam QueueBorderColor #333333
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBackgroundColor<<diseño>> #E8E8E8
skinparam NodeBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBackgroundColor<<diseño>> #E8E8E8
skinparam ArtifactBorderColor #333333
skinparam ArtifactBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBackgroundColor<<diseño>> #EFEFEF
skinparam FrameBorderColor #555555
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<diseño>> #E8E8E8
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBorderColor #777777
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontSize 10
skinparam LegendBorderColor #777777
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendFontSize 10
skinparam StereotypeFontSize 10
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor<<diseño>> #E8E8E8
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 13
skinparam LegendFontSize 11
hide footbox
actor "Organismo de\nrespuesta en campo" as OR
box "Teléfono Android: DanosCampo.apk" #FFFFFF
  participant "RegistrarDesastre\nViewModel" as VM
  participant "DesastreRepositorio\n(Impl)" as DR
  database "danos.db\nregistro_desastre" as ROOM
  participant "WorkManager\nSincronizacionWorker" as SW
  participant "EnviadorDesastres" as ENV
end box
participant "API Gateway\n[gateway]" as GW
participant "Gestión de Desastres\n[gestion-desastres]" as GD
database "gestion_desastres\n(desastre y bandeja)" as DB
queue "Bus de eventos\nplataforma.eventos" as BUS

OR -> VM : diligencia tipo, nombre, severidad,\nubicación, zona y municipios; guardar()
VM -> VM : ValidadorRegistroDesastre.validar()\n(RN-1, campos obligatorios)
VM -> DR : registrar(registro con id UUID\ngenerado en el teléfono)
DR -> ROOM : insertar(estadoEnvio = PENDIENTE)
DR -> SW : programar() trabajo único\ncon restricción de red
DR --> VM : Resultado.Exito
VM --> OR : "Pendiente de envío"

alt sin red
  SW -> SW : WorkManager no ejecuta el trabajo
  note over ROOM : El registro queda PENDIENTE.\nWorkManager reintenta al volver la red (AD-44).
end

SW -> ENV : doWork(): enviarPendientes()
ENV -> ROOM : leer PENDIENTE en orden de registro
ENV -> GW : POST /v1/desastres {id, tipo, severidad, zona, ...}\nAuthorization: Bearer JWT
GW -> GW : valida el JWT del Proveedor de identidad\ny el rol autoridad u organismo de la ruta\ngd-registrar (nivel 1, AD-49)

alt rol permitido
  GW -> GD : reenvía con el mismo JWT
  GD -> GD : valida el JWT y el actor (nivel 2)
  alt primer envío del id
    GD -> DB : una transacción: inserta el desastre y escribe\nEV-03, EV-05 y EV-27 en la bandeja de salida (AD-45)
    GD --> GW : 201 Created, desastre
  else reenvío del mismo id por el mismo autor
    GD -> DB : BuscarAsync(id)
    GD --> GW : el mismo desastre ya registrado\n(idempotente, AD-48)
  end
  GW --> ENV : 2xx
  ENV -> ROOM : actualizarEstado(ENVIADO)
else rol sin permiso
  GW --> ENV : 403 NO_AUTORIZADO
  ENV -> ROOM : actualizarEstado(RECHAZADO, motivo:\n"no tiene el rol organismo o autoridad")
else sin respuesta, 401 o 5xx
  ENV -> ROOM : incrementa intentos; sigue PENDIENTE
  ENV --> SW : Result.retry()
end

GD ->> BUS : el relevo de bandeja publica EV-03 Desastre creado,\nEV-05 Zona actualizada y EV-27 Organismos cambiados

legend bottom left
  Flecha con punta llena: llamada síncrona.  Flecha con punta abierta: mensaje asíncrono por el bus.  Flecha discontinua: respuesta.
  El identificador del desastre se genera en el teléfono; POST /v1/desastres es idempotente por ese id (AD-48, E-42). Estados locales: PENDIENTE, ENVIADO, RECHAZADO.
endlegend
@enduml
