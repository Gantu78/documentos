@startuml integracion
' SAD v1.2 - Modelo de integración con los sistemas externos por adaptadores (AD-03, AD-05, AD-09, AD-14, AD-36, AD-37, AD-45, AD-64; QA-01)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #333333
skinparam componentStyle uml2
skinparam BackgroundColor #FFFFFF
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBackgroundColor<<diseño>> #E8E8E8
skinparam ComponentBorderStyle<<diseño>> dashed
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor<<diseño>> #E8E8E8
skinparam QueueBorderColor #333333
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBackgroundColor<<diseño>> #E8E8E8
skinparam NodeBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBackgroundColor<<diseño>> #E8E8E8
skinparam ArtifactBorderColor #333333
skinparam ArtifactBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBackgroundColor<<diseño>> #EFEFEF
skinparam FrameBorderColor #555555
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<diseño>> #E8E8E8
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBorderColor #777777
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontSize 10
skinparam LegendBorderColor #777777
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendFontSize 10
skinparam StereotypeFontSize 10
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor<<diseño>> #E8E8E8
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 14
skinparam StereotypeFontSize 12
skinparam LegendFontSize 12
skinparam NoteFontSize 12

skinparam nodesep 8
skinparam ranksep 45

package "Sistemas externos" as EXT {
  rectangle "SE-2 GIS\n(capa de municipios, archivo)" <<sistema externo>> as SE2
  rectangle "SE-6 Finanzas\n[sim-se6]" <<sistema externo>> as SE6
  rectangle "SE-7 Proyectos\n[sim-se7]" <<sistema externo>> as SE7
  rectangle "SE-8 Notificación\n[sim-se8]" <<sistema externo>> as SE8
  rectangle "SE-1, SE-3,\nSE-4, SE-5" <<sistema externo>> as SEX
}

package "Adaptadores (uno por sistema externo, realizan ContratoAdaptador)" as ADP {
  component "adaptador-se2\nCapas: lectura y versión por SHA-256\nPublicacionDeCapas" <<implementado>> as A2
  component "adaptador-se6 (salida)\nLotes de EV-18, EV-19, EV-20\nClienteSe6, Traduccion" <<implementado>> as A6
  component "adaptador-se7-salida\nClienteSe7, Traduccion de EV-18, EV-20" <<implementado>> as A7S
  component "adaptador-se7-entrada\nsondeo cada 30 s desde la marca de avance" <<implementado>> as A7E
  component "adaptador-se8 (Jakarta EE, AD-66)\nAdaptadorSe8 @Stateless, Cortacircuitos,\nbandeja JPA; acuse por POST /v1/acuses" <<implementado>> as A8
  component "Adaptadores SE-1, SE-3,\nSE-4, SE-5" <<diseño>> as AX
}

package "Plataforma.Comun.Adaptadores (código común de los adaptadores)" as COM {
  interface "IContratoAdaptador\nISalidaAdaptador\nIEntradaAdaptador" as ICA
  component "Resiliencia (AD-64)\ntiempo de espera, reintento con espera\nexponencial y cortacircuitos" as RES
  component "MonitorCircuito y EstadoIntegracion\npublica EV-23 al abrir y al cerrar" as MON
  component "MarcaAvance\núltimo dato recibido (AD-14)" as MA
  component "EscritorBandeja y RelevoBandeja\n(Plataforma.Comun.Mensajeria, AD-45)" as BAN
}

package "Bus de eventos [bus1, bus2, bus3]" as BUS {
  queue "plataforma.eventos" as EX
  queue "q.salida.se6\nev18, ev19, ev20" as QS6
  queue "q.salida.se7\nev18, ev20" as QS7
  queue "q.salida.se8\nev28; ev03, ev04 (sustituto, L-11)" as QS8
  queue "dlq.salida.se6, se7, se8\n(plataforma.dlx)" as DLQ
}

package "Microservicios" as MS {
  component "reconstruccion\nproduce EV-18, EV-19, EV-20" <<implementado>> as RC
  component "consulta, consulta-danos,\nconsulta-programa\nconsumen EV-21, EV-23, EV-24" <<implementado>> as CQ
}

A2 --> SE2 : lee el archivo
A6 --> SE6 : HTTP JSON
A7S --> SE7 : HTTP JSON
A7E --> SE7 : HTTP JSON\nGET cambios
A8 --> SE8 : HTTP JSON\nPUT alertas
SE8 --> A8 : acuse (red interna)
AX --> SEX : protocolo de cada sistema

A2 ..|> ICA
A6 ..|> ICA
A7S ..|> ICA
A7E ..|> ICA
A8 ..|> ICA : equivalente Java
AX ..|> ICA
A6 ..> RES : cada llamada
A7S ..> RES : cada llamada
A7E ..> RES
A7E ..> MA
RES ..> MON
MON ..> BAN
A2 ..> BAN : EV-21
A7E ..> BAN : EV-24

RC ..> EX : EV-18, EV-19, EV-20
EX ..> QS6
EX ..> QS7
EX ..> QS8
QS6 ..> A6 : consume
QS7 ..> A7S : consume
QS8 ..> A8 : consume (JMS)
A8 ..> EX : publica EV-23, EV-29
QS6 ..> DLQ : rechazo
BAN ..> EX : publica EV-21, EV-23, EV-24
EX ..> CQ : q.consulta, q.consulta-danos,\nq.consulta-programa

note bottom of COM
  **SE-n no disponible:** el cortacircuitos se abre y no se invoca a SE-n;
  la salida se acumula en q.salida.se6, q.salida.se7 o q.salida.se8; EV-23 informa el
  estado y la consulta muestra el último dato con su marca de tiempo.
  **SE-n restablecido:** el circuito se cierra de forma progresiva, se
  entrega la cola de salida y la entrada pide el rango pendiente desde
  la marca de avance.
end note

legend bottom left
  **Notación** (diagrama de componentes UML). «implementado»: adaptador con código y contenedor en docker-compose; «diseño» (fondo gris, borde discontinuo): sin implementar.
  Flecha continua: llamada al sistema externo. Flecha discontinua: mensaje por el bus o uso de código común. Realización (triángulo): el adaptador implementa el contrato.
  Entre corchetes, el simulador que reemplaza al sistema externo en la implementación. Cola: rótulo con sus claves de enlace (definiciones.json).
endlegend
@enduml
