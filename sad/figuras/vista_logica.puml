@startuml vista_logica
' SAD v1.3 - Vista lógica: diagrama de componentes UML del diseño completo (AD-01, AD-02, AD-04, AD-08, AD-09, AD-15, AD-21, AD-45, AD-46, AD-49)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #333333
skinparam componentStyle uml2
skinparam BackgroundColor #FFFFFF
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBackgroundColor<<diseño>> #E8E8E8
skinparam ComponentBorderStyle<<diseño>> dashed
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor<<diseño>> #E8E8E8
skinparam QueueBorderColor #333333
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBackgroundColor<<diseño>> #E8E8E8
skinparam NodeBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBackgroundColor<<diseño>> #E8E8E8
skinparam ArtifactBorderColor #333333
skinparam ArtifactBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBackgroundColor<<diseño>> #EFEFEF
skinparam FrameBorderColor #555555
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<diseño>> #E8E8E8
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBorderColor #777777
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontSize 10
skinparam LegendBorderColor #777777
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendFontSize 10
skinparam StereotypeFontSize 10
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor<<diseño>> #E8E8E8
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #777777
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam defaultFontSize 18
skinparam ArrowFontSize 15
skinparam StereotypeFontSize 14
skinparam LegendFontSize 15
skinparam NoteFontSize 15
skinparam PackageFontSize 17
left to right direction
skinparam nodesep 4
skinparam ranksep 28


package "Presentación" as L1 {
  component "Consola de coordinación\n[web]" <<implementado>> as CC
  component "Portal público" <<diseño>> as PP
  component "Cliente móvil [DanosCampo.apk]\nréplica local y cola de operaciones" <<implementado>> as CM
}

component "Proveedor de identidad\n[keycloak, realm plataforma]\nOIDC con PKCE, emite el JWT" <<externo>> <<implementado>> as IDP
interface "OIDC / JWKS" as IOIDC
IDP - IOIDC

package "Acceso" as L2 {
  component "API Gateway [gateway]\ncatálogo rutas.json\nvalida JWT y rol (nivel 1)\nlímite de tasa y prioridad" <<implementado>> as GW
  interface "API REST /v1" as IREST
  GW - IREST
}

package "Dominio" as L3 {
  package "Microservicios de escritura" as WR {
    component "Gestión de Desastres [gestion-desastres]" <<implementado>> as GD
    component "Evaluación de Daños [evaluacion-danos]" <<implementado>> as ED
    component "Reconstrucción [reconstruccion]" <<implementado>> as RC
    component "Consolidación" <<diseño>> as CO
    component "Notificación" <<diseño>> as NO
    component "Gestión de Recursos" <<diseño>> as GR
    component "Personas Afectadas" <<diseño>> as PA
    component "Coordinación de Organismos" <<diseño>> as CR
  }
  package "Microservicios de consulta" as RD {
    component "Consulta [consulta]" <<implementado>> as CQ
    component "Consulta de Daños [consulta-danos]" <<implementado>> as CD
    component "Consulta del Programa [consulta-programa]" <<implementado>> as CP
  }
  component "Auditoría [auditoria]\nsolo consume eventos" <<implementado>> as AU
}

package "Infraestructura" as L4 {
  database "gestion_desastres\ny bandeja de salida" as dGD
  database "evaluacion_danos\ny bandeja de salida" as dED
  database "reconstruccion: copias locales\n(AD-46) y bandeja de salida" as dRC
  database "Almacén de archivos [archivos]\nevidencias y documentos" as dAR
  database "BD Consolidación" as dCO #E8E8E8;line.dashed
  database "BD Notificación" as dNO #E8E8E8;line.dashed
  database "BD Recursos" as dGR #E8E8E8;line.dashed
  database "BD Personas Afectadas" as dPA #E8E8E8;line.dashed
  database "BD Coordinación" as dCR #E8E8E8;line.dashed
  database "consulta" as dCQ
  database "Caché [cache]" as dCA
  database "consulta_danos" as dCD
  database "programa" as dCP
  database "auditoria (solo inserción)" as dAU
  queue "Bus de eventos [bus1, bus2, bus3]\nexchange plataforma.eventos" as BUS
}


package "Integración" as ADS {
  component "Adaptador SE-2 [adaptador-se2]" <<implementado>> as A2
  component "Adaptador SE-6 [adaptador-se6]" <<implementado>> as A6
  component "Adaptador SE-7\n[adaptador-se7-salida, adaptador-se7-entrada]" <<implementado>> as A7
  component "Adaptador SE-8 [adaptador-se8]\nJakarta EE en WildFly (AD-66)" <<implementado>> as A8
  component "Adaptadores SE-1, SE-3, SE-4, SE-5" <<diseño>> as AX
  interface "ContratoAdaptador" as ICA
  database "adaptador_se2, adaptadores\nmarca de avance y bandeja" as dAD
  database "adaptador_se8\nestado de entrega, marca\nde avance y bandeja" as dA8
}

rectangle "Sistemas externos\nSE-1 a SE-8" <<sistema externo>> as SE

CC --> IREST : REST
PP --> IREST : REST
CM --> IREST : REST
CC ..> IOIDC : OIDC con PKCE
CM ..> IOIDC : OIDC con PKCE
GW .[norank].> IOIDC : valida JWT (nivel 1)
WR .[norank].> IOIDC : valida JWT (nivel 2)
RD .[norank].> IOIDC : valida JWT (nivel 2)
GW --> WR : REST
GW --> RD : REST
GW --> AU : REST, solo consulta

GD --> dGD

ED --> dED
ED --> dAR
RC --> dRC
RC --> dAR
CO --> dCO
NO --> dNO
GR --> dGR
PA --> dPA
CR --> dCR
CQ --> dCQ
CQ --> dCA
CD --> dCD
CD --> dCA
CP --> dCP
AU --> dAU

WR ..> BUS : publica y consume
BUS ..> RD : eventos
BUS ..> AU : todos los eventos
ADS .[norank].> BUS : publica y consume
A2 --> dAD
A6 --> dAD
A7 --> dAD
A8 --> dA8
A2 ..|> ICA
A6 ..|> ICA
A7 ..|> ICA
A8 ..|> ICA
AX ..|> ICA
ADS --> SE : protocolo de\ncada sistema

note top of BUS
  Mensajes con el sobre de EventoCanónico
  (Plataforma.Comun.Eventos, EV-01 a EV-29, AD-09).
  Todo productor publica por su bandeja de salida (AD-45).
end note

legend bottom left
  **Notación** (diagrama de componentes UML). «implementado»: elemento con código y contenedor en proyectoparte2 o danos. «diseño»: elemento del diseño sin implementar. Almacén o cola con fondo gris y borde discontinuo: «diseño»; sin fondo: «implementado».
  [nombre]: servicio de docker-compose o artefacto que realiza el componente. Base de datos: nombre de la base en el contenedor db. Flecha continua sin rótulo: «usa» un almacén propio; ningún microservicio usa el almacén de otro (AD-01).
  Flecha continua REST: llamada síncrona. Flecha discontinua: evento por el bus (AD-02) o validación del token (AD-49). Círculo: interfaz provista. Realización: los adaptadores implementan ContratoAdaptador (AD-09); el de SE-8 lo implementa en Java (CON-9, AD-66).
endlegend
@enduml
